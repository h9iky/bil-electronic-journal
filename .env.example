# Скопируй в .env и подставь свои значения (файл .env не коммитится)
DATABASE_URL="file:./dev.db"

# Секрет для подписи сессионной куки (HMAC-SHA256).
# В dev есть безопасный дефолт; в production без секрета приложение падает.
# Сгенерировать: openssl rand -base64 32
SESSION_SECRET="change-me"

# Секрет для /api/bot/* — по нему бот Ask BIL доказывает, что он свой.
# Сгенерировать: openssl rand -hex 32
BOT_API_TOKEN="change-me"

# Юзернейм бота без @ — кнопка «Открыть бота» в карточке привязки.
TELEGRAM_BOT_USERNAME="ask_bil_bot"
