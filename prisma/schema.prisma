generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ⚠️ SQLite не поддерживает enum. Все «перечисления» — это String,
// валидируемые через src/lib/constants.ts (union-типы + type guards).

/// Пользователь: ученик, учитель или админ. Роли — см. constants.ts: ROLES.
model User {
  id        String   @id @default(cuid())
  fullName  String
  email     String   @unique
  role      String   @default("STUDENT") // STUDENT | TEACHER | ADMIN
  createdAt DateTime @default(now())

  // как ученик
  enrollments           Enrollment[]
  studyGrades           Grade[]
  studentActivityScores ActivityScore[]   @relation("StudentActivityScores")
  studentBehavior       BehaviorRecord[]  @relation("StudentBehaviorRecords")
  proposedForMe         ProposedGrade[]   @relation("ProposedForStudent")
  studentAttendance     Attendance[]      @relation("StudentAttendance")
  goals                 GradeGoal[]       @relation("StudentGoals")

  // как учитель
  teachings             Teaching[]
  authoredAssessments   Assessment[]      @relation("AssessmentsByTeacher")
  teacherActivityScores ActivityScore[]   @relation("TeacherActivityScores")
  teacherBehavior       BehaviorRecord[]  @relation("TeacherBehaviorRecords")
  proposedByMe          ProposedGrade[]   @relation("ProposedByTeacher")
  teacherAttendance     Attendance[]      @relation("TeacherAttendance")

  // классное руководство
  curatedClasses        Klass[]

  // как автор домашних заданий
  homeworkGiven         Homework[]      @relation("HomeworkByTeacher")

  // Telegram-бот (Ask BIL)
  telegramLink   TelegramLink?
  telegramCodes  TelegramLinkCode[]

  // личный план (планировщик ученика)
  plannerTasks PlannerTask[]
}

/// Класс: "10A" (номер 7–11 × буква A–E, латиница). Название собирается
/// из номера и буквы — см. src/lib/klass.ts. Настройки оценивания — в ClassSettings.
model Klass {
  id        String  @id @default(cuid())
  name      String // "10A"
  year      String // "2026/2027"
  curatorId String? // классный руководитель

  /// В одном учебном году класс с таким именем один: иначе «10A» начнёт
  /// плодиться, и ученику на регистрации будет из чего выбирать непонятно что.
  @@unique([name, year])

  curator         User?            @relation(fields: [curatorId], references: [id])
  settings        ClassSettings?
  enrollments     Enrollment[]
  teachings       Teaching[]
  assessments     Assessment[]
  behaviorRecords BehaviorRecord[]
  proposedGrades  ProposedGrade[]
  attendance      Attendance[]
  homework        Homework[]
  scheduleSlots   ScheduleSlot[]
}

/// Настройки оценивания класса: веса, пороги, округление, лимиты работ.
/// Хранятся в БД (а не в коде), потому что школы трактуют правила по-разному.
model ClassSettings {
  id        String @id @default(cuid())
  classId   String @unique
  // веса слагаемых четвертной (в процентах)
  sasWeight       Int @default(50)
  satWeight       Int @default(50)
  formativeWeight Int @default(0)
  // пороги перевода процента в оценку
  thresholdThree Int @default(40)
  thresholdFour  Int @default(65)
  thresholdFive  Int @default(85)
  // лимиты работ за четверть
  maxSasPerQuarter Int @default(4)
  maxSatPerQuarter Int @default(1)
  // округление процентов/итогов: HALF_UP | FLOOR | CEIL | NONE
  rounding String @default("HALF_UP")

  klass Klass @relation(fields: [classId], references: [id])
}

/// Ученик состоит в классе.
model Enrollment {
  id        String @id @default(cuid())
  studentId String
  classId   String

  student User  @relation(fields: [studentId], references: [id])
  klass   Klass @relation(fields: [classId], references: [id])

  @@unique([studentId, classId])
}

/// Учитель ведёт предмет в классе.
model Teaching {
  id        String @id @default(cuid())
  teacherId String
  subjectId String
  classId   String

  teacher User    @relation(fields: [teacherId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  klass   Klass   @relation(fields: [classId], references: [id])

  @@unique([teacherId, subjectId, classId])
}

/// Предмет: "Математика". Делится на разделы (Section) внутри четверти.
model Subject {
  id             String           @id @default(cuid())
  name           String
  code           String
  teachings      Teaching[]
  sections       Section[]
  assessments    Assessment[]
  activityScores ActivityScore[]
  proposedGrades ProposedGrade[]
  attendance     Attendance[]
  goals          GradeGoal[]
  homework       Homework[]
  scheduleSlots  ScheduleSlot[]
  plannerTasks   PlannerTask[]
}

/// Раздел/глава программы внутри четверти. К нему привязаны работы SAS (СОР).
model Section {
  id        String @id @default(cuid())
  subjectId String
  quarter   Int // 1..4
  title     String // "Тригонометриялық функциялар"
  order     Int    @default(0)

  subject     Subject      @relation(fields: [subjectId], references: [id])
  assessments Assessment[]
}

/// Работа: FORMATIVE (текущая), SAS (за раздел), SAT (за четверть).
/// maxScore задаёт учитель — 5/10/20/30…; status открывает работу ученикам.
model Assessment {
  id        String   @id @default(cuid())
  classId   String
  subjectId String
  teacherId String
  type      String // FORMATIVE | SAS | SAT
  status    String   @default("DRAFT") // DRAFT | PUBLISHED
  sectionId String? // обязателен для SAS, null для остальных
  title     String
  date      DateTime @default(now())
  maxScore  Int
  quarter   Int // 1..4

  klass   Klass    @relation(fields: [classId], references: [id])
  subject Subject  @relation(fields: [subjectId], references: [id])
  teacher User     @relation("AssessmentsByTeacher", fields: [teacherId], references: [id])
  section Section? @relation(fields: [sectionId], references: [id])
  grades  Grade[]
}

/// Оценка ученика за работу. score = балл (null = ещё не выставлен).
model Grade {
  id           String   @id @default(cuid())
  assessmentId String
  studentId    String
  score        Float?
  comment      String?
  updatedAt    DateTime @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id])
  student    User       @relation(fields: [studentId], references: [id])

  @@unique([assessmentId, studentId])
}

/// 🔥 Активность: оценка 1..10. Отдельная метрика, не входит в официальные оценки.
model ActivityScore {
  id        String   @id @default(cuid())
  studentId String
  subjectId String
  teacherId String
  date      DateTime @default(now())
  value     Int // 1..10
  comment   String?

  student User    @relation("StudentActivityScores", fields: [studentId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  teacher User    @relation("TeacherActivityScores", fields: [teacherId], references: [id])
}

/// 🔥 Поведение — ОТДЕЛЬНАЯ категория (POSITIVE | NEGATIVE | NEUTRAL).
/// Не смешивается с официальными оценками и активностью.
model BehaviorRecord {
  id        String   @id @default(cuid())
  studentId String
  classId   String
  teacherId String
  date      DateTime @default(now())
  kind      String // POSITIVE | NEGATIVE | NEUTRAL
  points    Int      @default(0) // модуль веса; знак берётся из kind
  comment   String?

  student User @relation("StudentBehaviorRecords", fields: [studentId], references: [id])
  klass   Klass @relation(fields: [classId], references: [id])
  teacher User  @relation("TeacherBehaviorRecords", fields: [teacherId], references: [id])
}

/// 🔥 «Потенциальная оценка»: рекомендация учителя на основе активности/поведения.
/// status: PENDING | ACCEPTED | REJECTED. Влияет на итог только после ACCEPTED.
model ProposedGrade {
  id          String @id @default(cuid())
  studentId   String
  subjectId   String
  classId     String
  quarter     Int
  value       Int // 2..5
  basis       String @default("activity") // activity | behavior
  status      String @default("PENDING") // PENDING | ACCEPTED | REJECTED
  createdById String

  student User    @relation("ProposedForStudent", fields: [studentId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  klass   Klass   @relation(fields: [classId], references: [id])
  creator User    @relation("ProposedByTeacher", fields: [createdById], references: [id])

  @@unique([studentId, subjectId, quarter, basis])
}

/// Посещаемость: отметка ученика на уроке (класс × предмет × день).
/// Статусы — см. constants.ts: PRESENT | ABSENT | LATE | EXCUSED.
/// `date` нормализуют до начала суток (UTC), чтобы работал уникальный ключ.
model Attendance {
  id        String   @id @default(cuid())
  studentId String
  classId   String
  subjectId String
  teacherId String
  date      DateTime // нормализовано до 00:00 UTC
  status    String   @default("PRESENT") // PRESENT | ABSENT | LATE | EXCUSED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student User    @relation("StudentAttendance", fields: [studentId], references: [id])
  klass   Klass   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  teacher User    @relation("TeacherAttendance", fields: [teacherId], references: [id])

  @@unique([studentId, subjectId, date])
}

/// Цель ученика: желаемая оценка по предмету за четверть (2..5).
/// Нужна «симулятору оценки»: показываем, что требуется на предстоящую работу.
model GradeGoal {
  id          String   @id @default(cuid())
  studentId   String
  subjectId   String
  quarter     Int // 1..4
  targetGrade Int // 2..5
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student User    @relation("StudentGoals", fields: [studentId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([studentId, subjectId, quarter])
}

/// Домашнее задание: что задано классу по предмету на урок конкретного дня.
/// `date` — день урока (нормализован до 00:00 UTC, как в `Attendance`);
/// `dueDate` — необязательный срок сдачи. Записей на день может быть несколько.
model Homework {
  id          String    @id @default(cuid())
  classId     String
  subjectId   String
  teacherId   String
  date        DateTime // день урока, 00:00 UTC
  dueDate     DateTime? // срок сдачи, 00:00 UTC
  title       String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  klass   Klass   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  teacher User    @relation("HomeworkByTeacher", fields: [teacherId], references: [id])

  @@index([classId, subjectId, date])
}

/// Урок в расписании класса: день недели (1=Пн..5=Пт) × номер урока (1..7).
/// Учитель не хранится — он уже определён в `Teaching` (учитель × предмет × класс).
model ScheduleSlot {
  id           String @id @default(cuid())
  classId      String
  dayOfWeek    Int // 1..5
  lessonNumber Int // 1..7
  subjectId    String

  klass   Klass   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([classId, dayOfWeek, lessonNumber])
}

/// Личное дело ученика (планировщик): «к 20.10 сдать эссе».
/// `date` — день (00:00 UTC, как у `Homework`), `time` — опциональные "HH:MM".
model PlannerTask {
  id        String   @id @default(cuid())
  studentId String
  date      DateTime // день дела, 00:00 UTC
  time      String? // "HH:MM" или null (без конкретного времени)
  title     String
  done      Boolean  @default(false)
  subjectId String? // необязательная привязка к предмету
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student User     @relation(fields: [studentId], references: [id])
  subject Subject? @relation(fields: [subjectId], references: [id])

  @@index([studentId, date])
}

/// Связь «аккаунт журнала ↔ Telegram»: одна привязка на пользователя.
/// Бот Ask BIL не знает про пользователей — он спрашивает журнал по telegramId.
/// Здесь же живут настройки бота: язык сообщений и тумблер вечерней сводки.
model TelegramLink {
  id            String   @id @default(cuid())
  userId        String   @unique
  telegramId    String   @unique
  username      String?
  locale        String   @default("ru") // ru | kk | en — язык сообщений бота
  digestEnabled Boolean  @default(true) // вечерняя сводка
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Одноразовый код привязки: генерирует журнал в кабинете, «съедает» бот
/// командой `/start <код>`. Живёт ограниченное время (см. lib/telegram.ts).
model TelegramLinkCode {
  id        String    @id @default(cuid())
  userId    String
  code      String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
